{
  "format": "llm-kit.project-models/v1",
  "description": "Shared cases of the request a selection resolves to, and of its OpenAI-compatible body fields. Read 'tracked' (and 'local', when present) as cases.json does, layer the personal layer over the tracked selections, then resolve the request of 'key' with the call layer 'call' (absent: an empty call). 'expect' is {request} (the resolved request; every key is present, null when unset) or {error: {code, path}}. 'wire', when present, renders the resolved request as OpenAI-compatible chat body fields: 'endpoint_style' is the consumer's style when the file declares none (null: none), and 'expect' is {fields} (every body field except model, messages, stream and user) or {error: {path}}. A reader that sends calls itself must put exactly these fields on the wire. Compare JSON values; object key order does not count. The contract is docs/reference/llm-kit-formats.md, 'Request settings'.",
  "cases": [
    {
      "name": "row-defaults-only",
      "note": "A selection with no effort and no request profile takes the row's defaults. traits come back and are never sent.",
      "tracked": {
        "lines": [
          "version: 1",
          "catalog:",
          "  - id: a",
          "    label: A",
          "    endpoint: openrouter",
          "    model: vendor/a",
          "    max_output_tokens: 4000",
          "    traits: [x]",
          "    request_defaults:",
          "      temperature: 0.7",
          "      top_p: 0.9",
          "      extras: {provider: {sort: latency}}",
          "selections:",
          "  k: {model: a}"
        ]
      },
      "key": "k",
      "expect": {
        "request": {
          "row": "a",
          "endpoint": "openrouter",
          "model": "vendor/a",
          "effort": null,
          "effort_style": null,
          "temperature": 0.7,
          "top_p": 0.9,
          "max_output_tokens": 4000,
          "reasoning_budget": null,
          "extras": {
            "provider": {
              "sort": "latency"
            }
          },
          "traits": [
            "x"
          ]
        }
      },
      "wire": {
        "endpoint_style": "top-level",
        "expect": {
          "fields": {
            "max_tokens": 4000,
            "temperature": 0.7,
            "top_p": 0.9,
            "provider": {
              "sort": "latency"
            }
          }
        }
      }
    },
