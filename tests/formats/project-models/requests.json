          "  k: {model: a}"
        ]
      },
      "key": "k",
      "expect": {
        "request": {
          "row": "a",
          "endpoint": "openrouter",
          "model": "vendor/a",
          "effort": null,
          "effort_style": null,
          "temperature": 0.5,
          "top_p": 0.8,
          "max_output_tokens": 300,
          "reasoning_budget": null,
