{
  "format": "llm-kit.consent/v2",
  "schema": "../../../packages/katsoft-llm-kit/src/llm_kit/schema/formats/consent.v2.schema.json",
  "description": "Shared cases for every reader of the llm-kit consent file. Read 'input' as the bytes of the whole file: 'lines' (join with LF and add one final LF), 'text' (UTF-8) or 'base64'. 'expect' is {config: {globals, scopes, connections}}: the global classes the file states, its scopes, and its connection approvals in file order (each {endpoint, host, key_env}); or {error: 'invalid'}, a refusal of the whole file. Every input of a 'config' case conforms to the schema. The contract is docs/reference/llm-kit-formats.md.",
  "cases": [
    {"name": "classes", "input": {"text": "{\"schema\": 2, \"local\": true, \"subscription\": true, \"metered\": false, \"scopes\": {}, \"updated_at\": \"2026-11-18T00:00:00+00:00\"}"},
     "expect": {"config": {"globals": {"local": true, "subscription": true, "metered": false}, "scopes": {}, "connections": []}}},
    {"name": "schema-only", "note": "A class the file does not state takes the built-in default; the reader returns only what the file states.",
     "input": {"text": "{\"schema\": 2}"},
     "expect": {"config": {"globals": {}, "scopes": {}, "connections": []}}},
    {"name": "scopes", "input": {"text": "{\"schema\": 2, \"metered\": false, \"scopes\": {\"databench\": {\"metered\": true}, \"task-kit\": {}}}"},
     "expect": {"config": {"globals": {"metered": false}, "scopes": {"databench": {"metered": true}, "task-kit": {}}, "connections": []}}},
    {"name": "one-approval", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"api.vendor.example\", \"key_env\": \"VENDOR_API_KEY\"}]}"},
     "expect": {"config": {"globals": {}, "scopes": {}, "connections": [{"endpoint": "direct", "host": "api.vendor.example", "key_env": "VENDOR_API_KEY"}]}}},
    {"name": "approvals-with-ports-and-addresses", "note": "A host keeps the port its base URL names; an IPv6 address is in brackets. File order is kept.",
     "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"lab\", \"host\": \"[::1]:8080\", \"key_env\": \"LAB_KEY\"}, {\"endpoint\": \"lab\", \"host\": \"127.0.0.1:8080\", \"key_env\": \"LAB_KEY\"}, {\"endpoint\": \"my vendor\", \"host\": \"api.vendor.example:8443\", \"key_env\": \"_K1\"}]}"},
     "expect": {"config": {"globals": {}, "scopes": {}, "connections": [{"endpoint": "lab", "host": "[::1]:8080", "key_env": "LAB_KEY"}, {"endpoint": "lab", "host": "127.0.0.1:8080", "key_env": "LAB_KEY"}, {"endpoint": "my vendor", "host": "api.vendor.example:8443", "key_env": "_K1"}]}}},
    {"name": "empty-approval-list", "input": {"text": "{\"schema\": 2, \"connections\": []}"},
     "expect": {"config": {"globals": {}, "scopes": {}, "connections": []}}},
    {"name": "not-json", "input": {"text": "{broken"}, "expect": {"error": "invalid"}},
    {"name": "not-an-object", "input": {"text": "[]"}, "expect": {"error": "invalid"}},
    {"name": "schema-missing", "input": {"text": "{\"metered\": true}"}, "expect": {"error": "invalid"}},
    {"name": "schema-1", "note": "The retired usage/spend file is refused, not translated.",
     "input": {"text": "{\"schema\": 1, \"usage\": true, \"spend\": true}"}, "expect": {"error": "invalid"}},
    {"name": "unknown-key", "input": {"text": "{\"schema\": 2, \"free\": true}"}, "expect": {"error": "invalid"}},
    {"name": "class-not-boolean", "input": {"text": "{\"schema\": 2, \"metered\": \"no\"}"}, "expect": {"error": "invalid"}},
    {"name": "scope-name-padded", "input": {"text": "{\"schema\": 2, \"scopes\": {\" pad\": {\"metered\": false}}}"}, "expect": {"error": "invalid"}},
    {"name": "connections-not-a-list", "input": {"text": "{\"schema\": 2, \"connections\": {\"direct\": {}}}"}, "expect": {"error": "invalid"}},
    {"name": "approval-not-an-object", "input": {"text": "{\"schema\": 2, \"connections\": [\"direct\"]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-missing-key-env", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"api.vendor.example\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-extra-key", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"api.vendor.example\", \"key_env\": \"K\", \"base_url\": \"https://api.vendor.example/v1\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-endpoint-empty", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"\", \"host\": \"api.vendor.example\", \"key_env\": \"K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-endpoint-padded", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct \", \"host\": \"api.vendor.example\", \"key_env\": \"K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-host-upper-case", "note": "A host is stored in lower case, as it is compared.",
     "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"API.vendor.example\", \"key_env\": \"K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-host-is-a-url", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"https://api.vendor.example/v1\", \"key_env\": \"K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-host-with-user-info", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"user@api.vendor.example\", \"key_env\": \"K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-host-bad-address", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"[not-an-address]\", \"key_env\": \"K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-key-env-not-a-name", "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"api.vendor.example\", \"key_env\": \"1K\"}]}"}, "expect": {"error": "invalid"}},
    {"name": "approval-key-env-null", "note": "A keyless connection needs no approval, so an approval always names a key variable.",
     "input": {"text": "{\"schema\": 2, \"connections\": [{\"endpoint\": \"direct\", \"host\": \"api.vendor.example\", \"key_env\": null}]}"}, "expect": {"error": "invalid"}}
  ]
}
