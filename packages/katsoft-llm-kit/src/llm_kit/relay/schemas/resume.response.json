{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relay-protocol/1/resume.response.json",
  "title": "resume result",
  "description": "Clear the relay or hub pause flag. Response result (unknown fields allowed).",
  "type": "object",
  "properties": {
    "pause": {
      "$ref": "#/$defs/pause_state"
    }
  },
  "required": [
    "pause"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "pause": {
        "relay": {
          "paused": false,
          "paused_since": null,
          "reason": null
        },
        "hub": {
          "paused": false,
          "paused_since": null,
          "reason": null
        }
      }
    }
  ]
}
