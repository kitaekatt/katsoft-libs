  ],
  "additionalProperties": false,
  "examples": [
    {
      "address": "m5pro/claude/7f3c2a10-5b7e-4c1d-9a8e-0d6f4b2c9e11"
    },
    {
      "address": "task:plugins-kit/harness-messaging",
