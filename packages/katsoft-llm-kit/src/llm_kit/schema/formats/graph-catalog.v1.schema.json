{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-kit.graph-catalog/v1",
  "title": "llm-kit graph catalog, version 1",
  "description": "The graphs a rendered graph page draws: the entry graphs, every graph file they run (each once, keyed by path) and the places that run each file. Reader rules the subset cannot state: every entries[].file, ref and used_by key is a key of files; a used_by node path names a node of its file; deps, output_sources values and outer_deps name nodes of the same or an enclosing node list. Written in llm-scripting-kit.json-schema-subset/v1. Contract: docs/reference/llm-kit-formats.md.",
  "type": "object",
  "properties": {
    "format": {"const": "llm-kit.graph-catalog/v1"},
    "project": {"description": "A display name for the page.", "type": "string"},
    "entries": {
      "description": "The graphs the catalog was built from, in order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {"description": "The project config name, or the graph id.", "type": "string", "minLength": 1},
          "file": {"description": "The key of the graph in files.", "type": "string", "minLength": 1}
        },
        "required": ["name", "file"],
        "additionalProperties": false
      }
    },
    "files": {
      "description": "Graph file path (relative to the root) -> the graph.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/graph"}
    },
    "used_by": {
      "description": "Graph file path -> the nodes that run it.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "node": {"description": "The node path in that file; / joins the ids of nested inline bodies.", "type": "string", "minLength": 1}
          },
          "required": ["file", "node"],
          "additionalProperties": false
        }
      }
    }
  },
  "required": ["format", "project", "entries", "files", "used_by"],
  "additionalProperties": false,
  "$defs": {
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {
      "description": "Output name -> the sibling nodes its binding reads.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/names"}
    },
    "graph": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "outer": {"type": "boolean"},
        "description": {"type": "string"},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"}
            },
            "required": ["name", "description"],
            "additionalProperties": false
          }
        },
        "outputs": {"$ref": "#/$defs/names"},
        "output_sources": {"$ref": "#/$defs/sources"},
        "nodes": {"$ref": "#/$defs/nodes"}
      },
      "required": ["id", "file", "outer", "description", "inputs", "outputs", "output_sources", "nodes"],
      "additionalProperties": false
    },
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "node": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["op", "graph", "map", "repeat", "human", "commit"]},
        "subtitle": {"type": "string"},
        "when": {"description": "The when expression as text, or null.", "type": ["string", "null"]},
        "deps": {"$ref": "#/$defs/names"},
        "reads_inputs": {"$ref": "#/$defs/names"},
        "detail": {"description": "Kind facts for display (op, over, key, max, until, carry, kind, adapter).", "type": "object"},
        "definition": {"description": "The node as written in its file; an inline body's nodes are left out.", "type": "object"},
        "ref": {"description": "The key in files of the graph file this node runs.", "type": "string", "minLength": 1},
        "body": {
          "description": "The inline body this map or repeat runs.",
          "type": "object",
          "properties": {
            "location": {"type": "string", "minLength": 1},
            "outputs": {"$ref": "#/$defs/names"},
            "output_sources": {"$ref": "#/$defs/sources"},
            "outer_deps": {"$ref": "#/$defs/names"},
            "nodes": {"$ref": "#/$defs/nodes"}
          },
          "required": ["location", "outputs", "output_sources", "outer_deps", "nodes"],
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "subtitle", "when", "deps", "reads_inputs", "detail", "definition"],
      "additionalProperties": false
    }
  }
}
