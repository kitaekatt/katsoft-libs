{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-kit.graph-catalog/v2",
  "title": "llm-kit graph catalog, version 2",
  "description": "Version 1 plus a required labels object: the titles, descriptions and edge texts a model inferred for each graph file. The graphs a rendered graph page draws: the entry graphs, every graph file they run (each once, keyed by path) and the places that run each file. Reader rules the subset cannot state: every entries[].file, ref and used_by key is a key of files; a used_by node path names a node of its file; deps, output_sources values and outer_deps name nodes of the same or an enclosing node list. Label rules: every labels key is a key of files; a nodes key is a node path of that file (/ joins the ids of nested inline bodies); a reads key is one of that node's deps; a source value indexes the sources of its file; graph inputs and outputs keys name the graph's ports; a key that names nothing is ignored, and an item with no label is drawn without one; a key of a source is 64 lowercase hex digits. Written in llm-scripting-kit.json-schema-subset/v1. Contract: docs/reference/llm-kit-formats.md.",
  "type": "object",
  "properties": {
    "format": {"const": "llm-kit.graph-catalog/v2"},
    "project": {"description": "A display name for the page.", "type": "string"},
    "entries": {
      "description": "The graphs the catalog was built from, in order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {"description": "The project config name, or the graph id.", "type": "string", "minLength": 1},
          "file": {"description": "The key of the graph in files.", "type": "string", "minLength": 1}
        },
        "required": ["name", "file"],
        "additionalProperties": false
      }
    },
    "files": {
      "description": "Graph file path (relative to the root) -> the graph.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/graph"}
    },
    "labels": {
      "description": "Graph file path -> the inferred labels of that file. Text in it was written by a model, so a reader shows it as inferred and never as markup.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/graphLabels"}
    },
    "used_by": {
      "description": "Graph file path -> the nodes that run it.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": {"type": "string", "minLength": 1},
            "node": {"description": "The node path in that file; / joins the ids of nested inline bodies.", "type": "string", "minLength": 1}
          },
          "required": ["file", "node"],
          "additionalProperties": false
        }
      }
    }
  },
  "required": ["format", "project", "entries", "files", "used_by", "labels"],
  "additionalProperties": false,
  "$defs": {
    "sourceIndex": {"description": "An index into sources of the same file.", "type": "integer", "minimum": 0},
    "labelSource": {
      "description": "One labelling request: the prompt version, the cache key of its primary call and the calls made (the primary call, then at most one follow-up for keys it left out).",
      "type": "object",
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "key": {"description": "The cache key: 64 lowercase hex digits.", "type": "string", "minLength": 64, "maxLength": 64},
        "calls": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "entry": {"description": "The model entry id that served the call.", "type": "string", "minLength": 1},
              "model": {"description": "The model that answered.", "type": "string", "minLength": 1}
            },
            "required": ["entry", "model"],
            "additionalProperties": false
          }
        }
      },
      "required": ["prompt", "key", "calls"],
      "additionalProperties": false
    },
    "graphLabels": {
      "type": "object",
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/labelSource"}},
        "graph": {
          "type": "object",
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 80},
            "purpose": {"type": "string", "minLength": 1, "maxLength": 400},
            "inputs": {"description": "Input name -> gloss.", "type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 160}},
            "outputs": {"description": "Output name -> gloss.", "type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 160}},
            "source": {"$ref": "#/$defs/sourceIndex"}
          },
          "required": ["title", "purpose", "inputs", "outputs", "source"],
          "additionalProperties": false
        },
        "nodes": {
          "description": "Node path -> its labels.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 80},
              "description": {"type": "string", "minLength": 1, "maxLength": 300},
              "reads": {"description": "Dep node id -> what this node reads from it.", "type": "object", "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 60}},
              "source": {"$ref": "#/$defs/sourceIndex"}
            },
            "required": ["title", "description", "reads", "source"],
            "additionalProperties": false
          }
        }
      },
      "required": ["sources", "graph", "nodes"],
      "additionalProperties": false
    },
    "names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {
      "description": "Output name -> the sibling nodes its binding reads.",
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/names"}
    },
    "graph": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "outer": {"type": "boolean"},
        "description": {"type": "string"},
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string"}
            },
            "required": ["name", "description"],
            "additionalProperties": false
          }
        },
        "outputs": {"$ref": "#/$defs/names"},
        "output_sources": {"$ref": "#/$defs/sources"},
        "nodes": {"$ref": "#/$defs/nodes"}
      },
      "required": ["id", "file", "outer", "description", "inputs", "outputs", "output_sources", "nodes"],
      "additionalProperties": false
    },
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "node": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["op", "graph", "map", "repeat", "human", "commit"]},
        "subtitle": {"type": "string"},
        "when": {"description": "The when expression as text, or null.", "type": ["string", "null"]},
        "deps": {"$ref": "#/$defs/names"},
        "reads_inputs": {"$ref": "#/$defs/names"},
        "detail": {"description": "Kind facts for display (op, over, key, max, until, carry, kind, adapter).", "type": "object"},
        "definition": {"description": "The node as written in its file; an inline body's nodes are left out.", "type": "object"},
        "ref": {"description": "The key in files of the graph file this node runs.", "type": "string", "minLength": 1},
        "body": {
          "description": "The inline body this map or repeat runs.",
          "type": "object",
          "properties": {
            "location": {"type": "string", "minLength": 1},
            "outputs": {"$ref": "#/$defs/names"},
            "output_sources": {"$ref": "#/$defs/sources"},
            "outer_deps": {"$ref": "#/$defs/names"},
            "nodes": {"$ref": "#/$defs/nodes"}
          },
          "required": ["location", "outputs", "output_sources", "outer_deps", "nodes"],
          "additionalProperties": false
        }
      },
      "required": ["id", "kind", "subtitle", "when", "deps", "reads_inputs", "detail", "definition"],
      "additionalProperties": false
    }
  }
}
