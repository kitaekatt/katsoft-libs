        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "inputs": {
          "$ref": "#/$defs/inputs"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "status": {
          "const": "invalid"
        },
        "ended_at": {
          "$ref": "#/$defs/time"
        },
        "scores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/score"
          }
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "timings": {
          "$ref": "#/$defs/timings"
        },
        "output": {
          "$ref": "#/$defs/output"
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "case",
        "content",
        "cost",
        "ended_at",
        "error",
        "flow",
        "format",
        "group",
        "id",
        "inputs",
        "labels",
        "output",
        "prompt",
        "provenance",
        "request",
        "resolved",
        "scores",
        "selection",
        "started_at",
        "status",
        "timings",
        "usage"
      ],
      "additionalProperties": false
    },
    "failed": {
      "description": "No usable answer (transport, provider or runner error): error is required; output is the partial answer or null.",
      "type": "object",
      "properties": {
        "format": {
          "const": "llm-kit.run-record/v1"
        },
        "id": {
          "description": "YYYYMMDDTHHMMSSffffffZ-<4 to 32 lowercase hex> (reader rule).",
          "type": "string",
          "minLength": 27,
          "maxLength": 55
        },
        "started_at": {
